# Salin file ini menjadi .env.local lalu isi nilainya.
# URL: Supabase Dashboard > Project Settings > Data API (atau API Keys).
# Kunci: pakai "Publishable key" (sb_publishable_...) atau "anon public" (legacy).
# JANGAN pernah memakai secret / service_role key di aplikasi.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
